{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build"
    },
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/dist/assets/$1"
    },
    {
      "src": "/api/alerts",
      "dest": "/api/alerts.js"
    },
    {
      "src": "/api/acknowledge/(.*)",
      "dest": "/api/acknowledge.js"
    },
    {
      "src": "/api/alert",
      "dest": "/api/alert.js"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}
